# Supabase Configuration
# The URL of your Supabase project (find in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# The anonymous public key for Supabase (find in Project Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Database Connection
# The direct connection string to your PostgreSQL database (used by Drizzle ORM/migrations)
# For Supabase, use the Transaction Pooler or Direct Connection string.
DATABASE_URL="postgres://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
